<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup/transfer exclusion rules, referenced via
  android:dataExtractionRules. Covers both cloud backup and device-to-device
  transfer — see expo_libsignal_backup_rules.xml for why this data must never
  be restored onto a different install.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="TinkSignalStore.xml" />
        <exclude domain="sharedpref" path="tink_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="TinkSignalStore.xml" />
        <exclude domain="sharedpref" path="tink_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
